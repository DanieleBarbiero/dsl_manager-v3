+        resolution={"status": "unresolved"},
+        expected=[],
+    )
+    report = coverage(rows, actual)
+    assert report["counts"]["due_missing_components"] == 1
+    assert report["counts"]["blocked_unresolved_components"] == 1
+    assert (
