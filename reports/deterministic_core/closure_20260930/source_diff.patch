+def test_schema2_upgrade_preserves_history(tmp_path, monkeypatch):
+    root = Path(__file__).parents[1]
+    baseline = "a7117e061b393123e3b7b2ec22bf171687756447"
+
+    def load(name):
+        source = subprocess.run(
