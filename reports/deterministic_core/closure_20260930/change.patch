+def fragment(kind, metadata, identity="F1", **extra):
+    return {
+        "fragment_id": identity,
+        "fragment_type": kind,
+        "source_revision_id": "R1",
+        "path_or_selector": "/" + identity,
+        "line_start": 1,
+        "line_end": 1,
+        "text": "explicit evidence",
+        "metadata_json": metadata,
+        **extra,
+    }
+
