++            for r in report["evidence"]
++            for c in r["components"]
++        }
++        if any(
++            actual.get(key) != status for key, status in expected_resolution.items()
++        ):
++            raise DomainError(
++                "unexpected_resolution",
++                "Risoluzione incompatibile con le attese della verifica.",
++            )
++    return report
