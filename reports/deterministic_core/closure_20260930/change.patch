+            e["data"]["target"]
+            for e in new.evidence
+            if e["type"] == "sql_dependency" and e["data"]["relation_type"] == relation
+        }
+        assert set(targets) <= actual
+        assert not {"P_ID", "T_IN.T_IN", "T_IN.T_AUX"} & actual
