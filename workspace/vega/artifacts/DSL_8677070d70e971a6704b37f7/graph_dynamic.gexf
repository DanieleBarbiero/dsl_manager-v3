      <node id="FACT_b89793f8428da47715039eca" label="TRG_CHIUDI_RICHIESTA.object_type">
        <attvalues>
          <attvalue for="kind" value="fact"/>
          <attvalue for="object_id" value="FACT_b89793f8428da47715039eca"/>
          <attvalue for="property_name" value="object_type"/>
          <attvalue for="property_value" value="trigger"/>
          <attvalue for="provenance" value="[{&quot;candidate_record_id&quot;:&quot;CAND_a024191d4860c3a02de140af&quot;,&quot;decision_id&quot;:&quot;DEC_eba28076c08bf95a651015ff&quot;,&quot;evidence_id&quot;:&quot;EV_f73e3125e76e0cf1e9b509ae&quot;,&quot;evidence_text&quot;:&quot;CREATE TRIGGER TRG_CHIUDI_RICHIESTA\nBEFORE UPDATE OF STATO ON RICHIESTA_RICAMBIO\nFOR EACH ROW\nBEGIN\n    IF :NEW.STATO = 'CHIUSA' AND :OLD.STATO &lt;&gt; 'CONSEGNATA' THEN\n        RAISE_APPLICATION_ERROR(-20001, 'La richiesta deve essere consegnata prima della chiusura');\n    END IF;\nEND;&quot;,&quot;evidence_text_hash&quot;:&quot;d48d63650b134f708bf744a0ca3452789d1ef4ce1f9e195c2e18a3375935d27c&quot;,&quot;file_path&quot;:&quot;vega/plsql/logica_vega.sql&quot;,&quot;rule&quot;:&quot;sql_unit&quot;,&quot;source_id&quot;:&quot;SRC_fe2716a8ce358a5e6d5f5356&quot;,&quot;source_revision_id&quot;:&quot;REV_c541599e315757cabfedd178&quot;,&quot;temporal_evidence_ids&quot;:[]}]"/>
